{
  "name": "at-in-physics-functions",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/test/smoke.test.js lib/test/ownerBootstrap.test.js lib/test/enrollmentValidation.test.js lib/test/sessionDiscovery.test.js lib/test/sessionDiscoveryMigration.test.js",
    "test:integration": "node --test lib/test/grantEnrollment.integration.test.js",
    "test:session-discovery:integration": "node --test lib/test/sessionDiscovery.integration.test.js",
    "test:session-discovery-migration": "node --test lib/test/sessionDiscoveryMigration.test.js",
    "test:session-discovery-migration:integration": "node --test lib/test/sessionDiscoveryMigration.integration.test.js",
    "owner:bootstrap": "npm run build && node lib/src/tooling/bootstrapOwnerCli.js",
    "session-discovery:migrate": "npm run build && node lib/src/tooling/sessionDiscoveryMigrationCli.js"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~6.0.2"
  }
}
