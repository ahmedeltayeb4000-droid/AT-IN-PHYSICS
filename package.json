{
  "name": "at-in-physics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "frontend:test": "node --experimental-strip-types --test test/enrollment.frontend.test.mjs",
    "preview": "vite preview",
    "firestore:seed": "node scripts/firestore/seed-content.mjs",
    "firestore:rules:test": "firebase emulators:exec --project demo-at-in-physics --only firestore \"node --test test/firestore.rules.test.mjs\"",
    "backend:build": "npm --prefix functions run build",
    "backend:test": "npm --prefix functions test",
    "backend:test:integration": "npm run backend:build && firebase emulators:exec --project demo-at-in-physics --only auth,firestore,functions \"npm --prefix functions run test:integration\"",
    "backend:test:session-discovery:integration": "npm run backend:build && firebase emulators:exec --project demo-at-in-physics --only firestore \"npm --prefix functions run test:session-discovery:integration\"",
    "backend:test:session-discovery-migration": "npm run backend:build && npm --prefix functions run test:session-discovery-migration",
    "backend:test:session-discovery-migration:integration": "npm run backend:build && firebase emulators:exec --project demo-at-in-physics --only firestore \"npm --prefix functions run test:session-discovery-migration:integration\"",
    "backend:test:lesson-content:integration": "npm run backend:build && firebase emulators:exec --project demo-at-in-physics --only firestore \"npm --prefix functions run test:lesson-content:integration\"",
    "owner:bootstrap": "npm --prefix functions run owner:bootstrap --",
    "session-discovery:migrate": "npm --prefix functions run session-discovery:migrate --",
    "lesson-content:publish": "npm --prefix functions run lesson-content:publish --",
    "video:package": "npm --prefix functions run video:package --",
    "backend:test:video-packaging": "npm --prefix functions run test:video-packaging",
    "emulators": "firebase emulators:start --project demo-at-in-physics --only auth,firestore,functions"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.3.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1"
  }
}
