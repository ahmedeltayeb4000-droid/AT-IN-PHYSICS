rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasActiveEnrollment(courseId) {
      let userId = request.auth.uid;
      let enrollmentPath = /databases/$(database)/documents/enrollments/$(userId + "_" + courseId);
      let enrollment = get(enrollmentPath).data;

      return exists(enrollmentPath)
        && enrollment.keys().hasAll([
          "userId",
          "courseId",
          "status",
          "expiresAt"
        ])
        && enrollment.userId == userId
        && enrollment.courseId == courseId
        && enrollment.status == "active"
        && (
          enrollment.expiresAt == null
          || (
            enrollment.expiresAt is timestamp
            && enrollment.expiresAt > request.time
          )
        );
    }

    function canReadCourseContent(courseId) {
      return request.auth != null && hasActiveEnrollment(courseId);
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.keys().hasAny(["owner"])
        && request.auth.token.owner == true;
    }

    function isValidCourseId(courseId) {
      return courseId.size() <= 128
        && courseId.matches("^[a-z0-9]+(-[a-z0-9]+)*$");
    }

    function isValidCourseText(value, maximum) {
      return value is string
        && value.size() > 0
        && value.size() <= maximum
        && value == value.trim()
        && !value.matches(".*[\\x00-\\x1F\\x7F].*");
    }

    function isValidCourseData(courseId, data) {
      return data.keys().hasAll([
          "slug",
          "title",
          "shortDescription",
          "status"
        ])
        && data.keys().hasOnly([
          "slug",
          "title",
          "shortDescription",
          "status"
        ])
        && isValidCourseId(courseId)
        && data.slug == courseId
        && (data.status == "draft" || data.status == "published")
        && isValidCourseText(data.title, 160)
        && isValidCourseText(data.shortDescription, 1000);
    }

    function isPublishedTrustedCourse(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return exists(coursePath)
        && isValidCourseData(courseId, get(coursePath).data)
        && get(coursePath).data.status == "published";
    }

    function isCanonicalAccessCodeId(accessCodeId) {
      return accessCodeId.matches("^[a-f0-9]{64}$");
    }

    function isValidAccessCodeData(data) {
      return data.keys().hasAll([
          "version",
          "courseId",
          "status",
          "createdAt",
          "expiresAt",
          "redeemedBy",
          "redeemedAt"
        ])
        && data.keys().hasOnly([
          "version",
          "courseId",
          "status",
          "createdAt",
          "expiresAt",
          "redeemedBy",
          "redeemedAt"
        ])
        && data.version == 1
        && isValidCourseId(data.courseId)
        && data.createdAt is timestamp
        && (data.expiresAt == null || data.expiresAt is timestamp)
        && (
          (
            (data.status == "active" || data.status == "revoked")
            && data.redeemedBy == null
            && data.redeemedAt == null
          )
          || (
            data.status == "redeemed"
            && data.redeemedBy is string
            && data.redeemedBy.size() > 0
            && data.redeemedAt is timestamp
          )
        );
    }

    function isActiveUnexpiredAccessCode(data) {
      return isValidAccessCodeData(data)
        && data.status == "active"
        && data.redeemedBy == null
        && data.redeemedAt == null
        && (data.expiresAt == null || data.expiresAt > request.time);
    }

    function isExactAccessCodeEnrollment(
      data,
      enrollmentId,
      userId,
      courseId,
      accessCodeId
    ) {
      return data.keys().hasAll([
          "userId",
          "courseId",
          "status",
          "grantedAt",
          "expiresAt",
          "source",
          "sourceId",
          "grantedBy"
        ])
        && data.keys().hasOnly([
          "userId",
          "courseId",
          "status",
          "grantedAt",
          "expiresAt",
          "source",
          "sourceId",
          "grantedBy"
        ])
        && enrollmentId == userId + "_" + courseId
        && data.userId == userId
        && data.courseId == courseId
        && data.status == "active"
        && data.grantedAt == request.time
        && data.expiresAt == null
        && data.source == "access_code"
        && data.sourceId == accessCodeId
        && data.grantedBy == "access-code-service";
    }

    function isExactRedeemedAccessCode(before, after, userId) {
      return isValidAccessCodeData(after)
        && after.version == before.version
        && after.courseId == before.courseId
        && after.createdAt == before.createdAt
        && after.expiresAt == before.expiresAt
        && after.status == "redeemed"
        && after.redeemedBy == userId
        && after.redeemedAt == request.time;
    }

    function isValidCreatedCourse(courseId) {
      return isValidCourseData(courseId, request.resource.data)
        && request.resource.data.status == "draft";
    }

    function isValidCreatedModule(courseId, moduleId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return exists(coursePath)
        && isValidCourseData(courseId, get(coursePath).data)
        && isValidModuleData(moduleId, request.resource.data);
    }

    function isValidModuleData(moduleId, data) {
      return isValidCourseId(moduleId)
        && data.keys().hasAll(["title", "order"])
        && data.keys().hasOnly(["title", "order"])
        && isValidCourseText(data.title, 160)
        && data.order is int
        && data.order >= 0
        && data.order <= 9007199254740991;
    }

    function isValidCreatedSession(courseId, moduleId, sessionId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let modulePath = /databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId);
      let data = request.resource.data;
      return isValidCourseId(sessionId)
        && exists(coursePath)
        && isValidCourseData(courseId, get(coursePath).data)
        && exists(modulePath)
        && isValidModuleData(moduleId, get(modulePath).data)
        && data.keys().hasAll(["title", "order"])
        && data.keys().hasAll(["publicationStatus"])
        && data.keys().hasOnly(["title", "order", "publicationStatus"])
        && isValidCourseText(data.title, 160)
        && data.order is int
        && data.order >= 0
        && data.order <= 9007199254740991
        && data.publicationStatus == "draft";
    }

    function isSessionVisible(sessionData) {
      return sessionData.keys().hasAll(["publicationStatus"])
        && sessionData.publicationStatus == "published"
        && (
          !sessionData.keys().hasAny(["releaseAt"])
          || (
            sessionData.releaseAt is timestamp
            && sessionData.releaseAt <= request.time
          )
        );
    }

    function isValidVideoAssetId(value) {
      return value is string
        && value.size() <= 128
        && value.matches("^[a-z0-9]+(-[a-z0-9]+)*$");
    }

    function isValidContentKey(value) {
      // Canonical unpadded base64url for 32 bytes has 43 characters and
      // a final character whose unused padding bits are zero.
      return value is string
        && value.matches("^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$");
    }

    function isVideoAccessDocument(sessionData) {
      return sessionData.keys().hasAll(["videoAssetId"])
        && isValidVideoAssetId(sessionData.videoAssetId)
        && resource.data.keys().hasAll(["videoAssetId", "contentKey"])
        && resource.data.keys().hasOnly(["videoAssetId", "contentKey"])
        && isValidVideoAssetId(resource.data.videoAssetId)
        && resource.data.videoAssetId == sessionData.videoAssetId
        && isValidContentKey(resource.data.contentKey);
    }

    function isSessionDiscoveryManifest() {
      return resource.data.keys().hasAll(["sessionIds"])
        && resource.data.keys().hasOnly(["sessionIds"])
        && resource.data.sessionIds is list
        // Rules cannot iterate an arbitrary list; remaining ID shape is validated by trusted code.
        && !resource.data.sessionIds.hasAny([""])
        && resource.data.sessionIds.join("").matches("^[^/]*$")
        && resource.data.sessionIds.size()
          == resource.data.sessionIds.toSet().size();
    }

    function isValidProtectedResourceFileName(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 120
        && value == value.trim()
        && value.matches("^[A-Za-z0-9][A-Za-z0-9._ ()-]*[.]pdf$")
        && !value.matches(".*[.][.].*")
        && !value.matches(".*[ .][.]pdf$")
        && !value.matches("^([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])([.].*)?[.]pdf$");
    }

    function isValidProtectedResourceMetadata(data, resourceId, route) {
      return data.keys().hasAll([
          "version", "resourceId", "title", "originalFileName", "mimeType",
          "plaintextSize", "formatVersion", "ciphertextRoute",
          "ciphertextSha256", "ciphertextSize", "createdAt", "boundAt"
        ])
        && data.keys().hasOnly([
          "version", "resourceId", "title", "originalFileName", "mimeType",
          "plaintextSize", "formatVersion", "ciphertextRoute",
          "ciphertextSha256", "ciphertextSize", "createdAt", "boundAt"
        ])
        && data.version == 1
        && isValidCourseId(resourceId)
        && data.resourceId == resourceId
        && isValidCourseText(data.title, 160)
        && isValidProtectedResourceFileName(data.originalFileName)
        && data.mimeType == "application/pdf"
        && data.plaintextSize is int
        && data.plaintextSize > 0
        && data.plaintextSize <= 20971520
        && data.formatVersion == "ATR1"
        && data.ciphertextRoute == route
        && data.ciphertextSha256 is string
        && data.ciphertextSha256.matches("^[a-f0-9]{64}$")
        && data.ciphertextSize is int
        && data.ciphertextSize == data.plaintextSize + 32
        && data.ciphertextSize <= 20971552
        && data.createdAt is timestamp
        && data.boundAt is timestamp;
    }

    function isValidProtectedResourceAccess(data, resourceId) {
      return data.keys().hasAll([
          "version", "resourceId", "formatVersion", "ciphertextSha256",
          "contentKey"
        ])
        && data.keys().hasOnly([
          "version", "resourceId", "formatVersion", "ciphertextSha256",
          "contentKey"
        ])
        && data.version == 1
        && data.resourceId == resourceId
        && data.formatVersion == "ATR1"
        && data.ciphertextSha256 is string
        && data.ciphertextSha256.matches("^[a-f0-9]{64}$")
        && isValidContentKey(data.contentKey);
    }

    function isPairedProtectedResource(metadata, access) {
      return metadata.resourceId == access.resourceId
        && metadata.formatVersion == access.formatVersion
        && metadata.ciphertextSha256 == access.ciphertextSha256;
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == "published" || isOwner();
      allow create: if isOwner() && isValidCreatedCourse(courseId);
      allow update, delete: if false;

      match /resources/{resourceId} {
        allow get: if (canReadCourseContent(courseId) || isOwner())
          && isValidProtectedResourceMetadata(
            resource.data,
            resourceId,
            "/protected-resources/courses/" + courseId + "/resources/" + resourceId + ".atr1"
          );
        allow list: if canReadCourseContent(courseId) || isOwner();
        allow create, update, delete: if false;

        match /access/{accessId} {
          allow get: if accessId == "primary"
            && canReadCourseContent(courseId)
            && !isOwner()
            && exists(/databases/$(database)/documents/courses/$(courseId)/resources/$(resourceId))
            && isValidProtectedResourceMetadata(
              get(/databases/$(database)/documents/courses/$(courseId)/resources/$(resourceId)).data,
              resourceId,
              "/protected-resources/courses/" + courseId + "/resources/" + resourceId + ".atr1"
            )
            && isValidProtectedResourceAccess(resource.data, resourceId)
            && isPairedProtectedResource(
              get(/databases/$(database)/documents/courses/$(courseId)/resources/$(resourceId)).data,
              resource.data
            );
          allow list, create, update, delete: if false;
        }
      }

      match /modules/{moduleId} {
        allow get: if canReadCourseContent(courseId) || isOwner();
        allow list: if canReadCourseContent(courseId) || isOwner();
        allow create: if isOwner() && isValidCreatedModule(courseId, moduleId);
        allow update, delete: if false;

        match /sessionDiscovery/{discoveryId} {
          allow get: if discoveryId == "visible"
            && canReadCourseContent(courseId)
            && isSessionDiscoveryManifest();
        }

        match /sessions/{sessionId} {
          allow get: if (
              canReadCourseContent(courseId)
              && isSessionVisible(resource.data)
            ) || isOwner();
          allow list: if isOwner();
          allow create: if isOwner()
            && isValidCreatedSession(courseId, moduleId, sessionId);
          allow update, delete: if false;

          match /resources/{resourceId} {
            allow get: if (
                (
                  canReadCourseContent(courseId)
                  && exists(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId))
                  && isSessionVisible(
                    get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)).data
                  )
                ) || isOwner()
              )
              && isValidProtectedResourceMetadata(
                resource.data,
                resourceId,
                "/protected-resources/courses/" + courseId + "/modules/" + moduleId + "/sessions/" + sessionId + "/resources/" + resourceId + ".atr1"
              );
            allow list: if (
                canReadCourseContent(courseId)
                && exists(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId))
                && isSessionVisible(
                  get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)).data
                )
              ) || isOwner();
            allow create, update, delete: if false;

            match /access/{accessId} {
              allow get: if accessId == "primary"
                && canReadCourseContent(courseId)
                && !isOwner()
                && exists(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId))
                && isSessionVisible(
                  get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)).data
                )
                && exists(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)/resources/$(resourceId))
                && isValidProtectedResourceMetadata(
                  get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)/resources/$(resourceId)).data,
                  resourceId,
                  "/protected-resources/courses/" + courseId + "/modules/" + moduleId + "/sessions/" + sessionId + "/resources/" + resourceId + ".atr1"
                )
                && isValidProtectedResourceAccess(resource.data, resourceId)
                && isPairedProtectedResource(
                  get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)/resources/$(resourceId)).data,
                  resource.data
                );
              allow list, create, update, delete: if false;
            }
          }

          match /videoAccess/{accessId} {
            allow get: if accessId == "primary"
              && canReadCourseContent(courseId)
              && exists(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId))
              && isSessionVisible(
                get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)).data
              )
              && isVideoAccessDocument(
                get(/databases/$(database)/documents/courses/$(courseId)/modules/$(moduleId)/sessions/$(sessionId)).data
              );
            allow list, create, update, delete: if false;
          }
        }
      }
    }

    match /accessCodes/{accessCodeId} {
      allow get: if request.auth != null
        && isCanonicalAccessCodeId(accessCodeId)
        && isValidAccessCodeData(resource.data)
        && (
          isActiveUnexpiredAccessCode(resource.data)
          || (
            resource.data.status == "redeemed"
            && resource.data.redeemedBy == request.auth.uid
          )
        );
      allow list, create, delete: if false;
      allow update: if request.auth != null
        && isCanonicalAccessCodeId(accessCodeId)
        && isActiveUnexpiredAccessCode(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "redeemedBy", "redeemedAt"])
        && isExactRedeemedAccessCode(
          resource.data,
          request.resource.data,
          request.auth.uid
        )
        && isPublishedTrustedCourse(resource.data.courseId)
        && !exists(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + resource.data.courseId)
        )
        && existsAfter(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + resource.data.courseId)
        )
        && isExactAccessCodeEnrollment(
          getAfter(
            /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + resource.data.courseId)
          ).data,
          request.auth.uid + "_" + resource.data.courseId,
          request.auth.uid,
          resource.data.courseId,
          accessCodeId
        );
    }

    match /enrollments/{enrollmentId} {
      allow get: if request.auth != null
        && (
          !exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
          || resource.data.userId == request.auth.uid
        );
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && isCanonicalAccessCodeId(request.resource.data.sourceId)
        && isExactAccessCodeEnrollment(
          request.resource.data,
          enrollmentId,
          request.auth.uid,
          request.resource.data.courseId,
          request.resource.data.sourceId
        )
        && isPublishedTrustedCourse(request.resource.data.courseId)
        && exists(
          /databases/$(database)/documents/accessCodes/$(request.resource.data.sourceId)
        )
        && isActiveUnexpiredAccessCode(
          get(
            /databases/$(database)/documents/accessCodes/$(request.resource.data.sourceId)
          ).data
        )
        && get(
          /databases/$(database)/documents/accessCodes/$(request.resource.data.sourceId)
        ).data.courseId == request.resource.data.courseId
        && existsAfter(
          /databases/$(database)/documents/accessCodes/$(request.resource.data.sourceId)
        )
        && isExactRedeemedAccessCode(
          get(
            /databases/$(database)/documents/accessCodes/$(request.resource.data.sourceId)
          ).data,
          getAfter(
            /databases/$(database)/documents/accessCodes/$(request.resource.data.sourceId)
          ).data,
          request.auth.uid
        );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
